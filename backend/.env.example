# Копировать в .env перед запуском (или переопределять через docker-compose environment)
DATABASE_URL=postgresql+asyncpg://station:station@db:5432/station

# Станция/мастер — фиксированный логин (см. ARCHITECTURE.md)
STATION_LOGIN=mechanic
STATION_PASSWORD=change-me

# ИИ-модуль диагностики (C4): если пусто — используется rule-based фолбэк
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
